{
  "name": "@gachlab/devup",
  "version": "0.19.1",
  "description": "Dev stack runner with TUI, lazy proxy, and reverse proxy support",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "devup": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/control-plane/client.d.ts",
      "import": "./dist/control-plane/client.js"
    },
    "./contract/status-snapshot.json": "./contract/status-snapshot.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "contract"
  ],
  "keywords": [
    "dev",
    "monorepo",
    "microservices",
    "tui",
    "terminal",
    "process-manager",
    "lazy-proxy",
    "traefik",
    "ink",
    "devtools"
  ],
  "author": "gachlab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gachlab/devup.git"
  },
  "homepage": "https://github.com/gachlab/devup#readme",
  "bugs": {
    "url": "https://github.com/gachlab/devup/issues"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsup && tsc --emitDeclarationOnly",
    "contract:update": "node --import tsx scripts/update-contract.ts",
    "dev": "tsup --watch",
    "prepack": "npm pkg fix",
    "prepublishOnly": "npm run build",
    "test": "node --import tsx --test \"tests/**/*.test.ts\" \"tests/**/*.test.tsx\"",
    "test:unit": "node --import tsx --test --experimental-test-coverage \"tests/unit/**/*.test.ts\" \"tests/unit/**/*.test.tsx\"",
    "test:integration": "node --import tsx --test --experimental-test-coverage \"tests/integration/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"tests/**/*.test.ts\" \"tests/**/*.test.tsx\"",
    "test:coverage": "node --import tsx --test --experimental-test-coverage \"tests/**/*.test.ts\" \"tests/**/*.test.tsx\""
  },
  "dependencies": {
    "ink": "7.0.1",
    "react": "19.2.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "22.15.3",
    "@types/react": "19.2.14",
    "ink-testing-library": "^4.0.0",
    "react-dom": "^19.2.5",
    "tsup": "8.5.1",
    "tsx": "4.19.4",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
